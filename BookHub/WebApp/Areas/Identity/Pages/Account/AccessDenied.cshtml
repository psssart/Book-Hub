@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="d-flex flex-column align-items-center justify-content-center m-3 mt-4">
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">You do not have access to this resource.</p>
    <img src="~/img/jpg/you-shall-not-pass-quote-1.jpg" alt="You shall not pass" />
</div>
