@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <title>@ViewData["Title"]</title>

</head>
<body>
<img src="~/img/svg/Ellipse.svg" alt="background-ellipses" class="image-ellipse-login">

<div class="auth-container container mt-2">
    
    <div class="row m-2">
        <div class="col-12 col-md-9 col-lg-7 auth-title text-center p-0">
            Authorisation
        </div>
        <div class="col-0 col-md-3 col-lg-5 d-none d-md-block errors-title text-start align-self-center ps-4">
            @* system info label for desktop *@
        </div>
    </div>
    
    <div class="row px-3">
        <div class="col-12 col-md-9 col-lg-7 auth-frame px-0">
            
            <form id="account" method="post" class="container">
                
                <div class="row mt-2">
                    
                    <div class="col-12">
                        <div class="form-element">
                            <label asp-for="Input.Email" class="label-text">Email</label>
                            <div class="d-flex justify-content-center">
                                <input asp-for="Input.Email" type="text" placeholder="name@example.com" aria-required="true" autocomplete="username">
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.Email" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
                <div class="row">
                    
                    <div class="col-12">
                        <div class="form-element">
                            <label asp-for="Input.Password" class="label-text">Password</label>
                            <div class="d-flex justify-content-center">
                                <input asp-for="Input.Password" type="password" autocomplete="current-password" aria-required="true" placeholder="Password">
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.Password" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
                <div class="row">
                    
                    <div class="col-6">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small-text d-block text-center">Forgot your password?</a>
                    </div>
                    
                    <div class="col-6">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small-text d-block text-center">Register as a new user</a>
                    </div>
                    
                </div>
                
                <div asp-validation-summary="ModelOnly" class="validation-summary text-danger fs-4 mt-2" role="alert"></div>
                
                <button id="login-submit" type="submit" class="login-button w-100 mt-4" onclick="this.closest('form').submit();">
                    Log in
                </button>
                
                <div class="logo-auth m-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex justify-content-center">
                        <img src="~/img/svg/BookHub-auth-logo.svg" alt="BookHub" class="img-fluid">
                    </a>
                </div>
            </form>
            
        </div>
        @* Attention block only for desktop *@
        <div class="col-0 col-md-3 col-lg-5 d-none d-md-block">
            @* system info text *@
        </div>
    </div>
    
    @* Attention block only for mobile *@
    <div class="row mt-2 px-4 d-md-none">
        <div class="col-12 px-0 errors-title text-start align-self-center">
            @* system info label *@
        </div>
    </div>
    <div class="row px-4 d-md-none">
        <div class="col-12 px-0">
            @* system info text *@
        </div>
    </div>
</div>
</body>
</html>

<style>
    .validation-summary ul {
        margin-bottom: 0;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
