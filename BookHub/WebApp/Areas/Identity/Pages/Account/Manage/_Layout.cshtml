@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "_Layout";
    }
}

<h1 class="auth-title text-center fs-1 mb-0 mt-3">Manage your account</h1>

<div class="mx-2">
    <hr class="my-3" />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <hr class="my-3 d-md-none" />
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
