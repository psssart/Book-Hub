@page
@model WebApp.Areas.Identity.Pages.Account.Manage.IndexModel
@{
ViewData["Title"] = "Profile";
ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="auth-title fs-3">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <!-- Avatar block -->
            <div class="mb-3 d-flex align-items-center gap-3">
                <div class="rounded-circle overflow-hidden border"
                     style="width:96px;height:96px;border-color:var(--border-color); background-color:var(--bg-tertiary); box-shadow:var(--shadow);">
                    <img id="avatar-preview"
                         src="@Model.AvatarUrl"
                         alt="avatar"
                         class="w-100 h-100 object-fit-cover" />
                </div>

                <div class="d-flex flex-column gap-2">
                    <label class="btn btn-sm"
                           style="border:1px solid var(--border-color); background:var(--bg-secondary); color:var(--text-primary);">
                        <i class="bi bi-camera me-1"></i> Change photo
                        <input asp-for="Input.Avatar" type="file" accept="image/*" class="d-none" />
                    </label>

                    <button type="submit" asp-page-handler="RemoveAvatar"
                            class="btn btn-sm"
                            style="border:1px solid var(--border-color); background:transparent; color:var(--text-secondary);">
                        <i class="bi bi-trash me-1"></i> Remove
                    </button>

                    <span asp-validation-for="Input.Avatar" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled
                       style="background-color:var(--bg-primary); color:var(--text-secondary);"/>
                <label asp-for="Username" class="form-label"></label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit"
                    class="w-100 fs-6 py-2"
                    style="background:var(--accent-color); color:#fff; border:none; border-radius:.5rem;">
                Save
            </button>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    // live preview
    const fileInput = document.querySelector('input[name="Input.Avatar"]');
    const preview = document.getElementById('avatar-preview');

    if (fileInput) {
        fileInput.addEventListener('change', (e) => {
            const f = e.target.files && e.target.files[0];
            if (!f) return;
            const url = URL.createObjectURL(f);
            preview.src = url;
        });
    }
</script>
}
