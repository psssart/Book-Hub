@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/auth.css">

    <title>@ViewData["Title"]</title>

</head>
<body>
<img src="~/img/svg/Ellipse.svg" alt="background-ellipses" class="image-ellipse-login">

<div class="reg-container container mt-2">

    <div class="row m-2">
        <div class="col-12 col-md-10 col-lg-8 auth-title text-center p-0">
            Registration
        </div>
        <div class="col-0 col-md-2 col-lg-4 d-none d-md-block errors-title text-start align-self-center ps-4">
            @* system info label for desktop *@
        </div>
    </div>

    <div class="row px-3">
        <div class="col-12 col-md-10 col-lg-8 auth-frame px-0">

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data"
                  class="container">
                
                <div class="row mt-2">
                    
                    <div class="col-12 col-md-6">
                        <div class="form-element-reg">
                            <label asp-for="Input.FirstName" class="label-text">First Name</label>
                            <div class="d-flex justify-content-center">
                                <input asp-for="Input.FirstName" autocomplete="firstname" aria-required="true" placeholder="First Name"/>
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.FirstName" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="form-element-reg">
                            <label asp-for="Input.LastName" class="label-text">Last name</label>
                            <div class="d-flex justify-content-center">
                                <input asp-for="Input.LastName" autocomplete="lastname" aria-required="true" placeholder="Last Name"/>
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.LastName" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
                <div class="row">
                    
                    <div class="col-12 col-md-6">
                        <div class="form-element-reg">
                            <label asp-for="Input.Email" class="label-text">Email</label>
                            <div class="d-flex justify-content-center">
                                <input asp-for="Input.Email" type="text" autocomplete="username" aria-required="true" placeholder="name@example.com">
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.Email" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12 col-md-6">
                        <div class="form-element-reg">
                            <label asp-for="Input.Password" class="label-text">Password</label>
                            <div class="d-flex justify-content-center">
                                <div class="password-input-wrap">
                                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Password"/>
                                    <button type="button" class="toggle-password-btn" tabindex="-1" aria-label="Toggle password visibility">
                                        <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="eye-closed" style="display:none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.Password" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
                <div class="row">
                    
                    <div class="col-12 mt-3 col-md-6 order-2 order-md-1 d-flex justify-content-center align-items-center">
                        <div class="form-element-reg">
                            <div class="upload d-flex gap-2">
                                <label for="avatar" asp-for="Input.AvatarImageData" class="custom-file-upload">
                                    Avatar Photo
                                </label>
                                <input asp-for="Input.AvatarImageData" type="file" id="avatar">
                                <img id="avatar-preview" class="avatar mt-0" src="~/img/svg/profile-nophoto.svg" alt="">
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.AvatarImageData" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12 col-md-6 order-1 order-md-2">
                        <div class="form-element-reg">
                            <label asp-for="Input.ConfirmPassword" class="label-text">Confirm Password</label>
                            <div class="d-flex justify-content-center">
                                <div class="password-input-wrap">
                                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirmation password"/>
                                    <button type="button" class="toggle-password-btn" tabindex="-1" aria-label="Toggle password visibility">
                                        <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="eye-closed" style="display:none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center">
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger fs-6"></span>
                            </div>
                        </div>
                    </div>
                    
                </div>
                
                <div asp-validation-summary="ModelOnly" class="validation-summary text-danger fs-4 mt-2" role="alert"></div>
                
                <button id="registerSubmit" type="submit" class="reg-button w-100 mt-4" onclick="this.closest('form').submit();">
                    Register
                </button>
                
                <div class="logo-reg m-3">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex justify-content-center">
                        <img src="~/img/svg/BookHub-auth-logo.svg" alt="" class="img-fluid">
                    </a>
                </div>
                
            </form>
        
        </div>
        @* Attention block only for desktop *@
        <div class="col-0 col-md-2 col-lg-4 d-none d-md-block">
            @* system info text *@
        </div>
    </div>

    @* Attention block only for mobile *@
    <div class="row mt-2 px-4 d-md-none">
        <div class="col-12 px-0 errors-title text-start align-self-center">
            @* system info label *@
        </div>
    </div>
    <div class="row px-4 d-md-none">
        <div class="col-12 px-0">
            @* system info text *@
        </div>
    </div>
</div>
</body>
</html>

<style>
    .validation-summary ul {
        margin-bottom: 0;
    }
</style>

<script>
(function() {
    // Password toggle
    document.querySelectorAll('.toggle-password-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var input = this.parentElement.querySelector('input');
            var eyeOpen = this.querySelector('.eye-open');
            var eyeClosed = this.querySelector('.eye-closed');
            if (input.type === 'password') {
                input.type = 'text';
                eyeOpen.style.display = 'none';
                eyeClosed.style.display = 'block';
            } else {
                input.type = 'password';
                eyeOpen.style.display = 'block';
                eyeClosed.style.display = 'none';
            }
        });
    });

    // Save form data to localStorage (non-sensitive fields only)
    var fields = {
        'Input_FirstName': 'bookhub_reg_firstname',
        'Input_LastName': 'bookhub_reg_lastname',
        'Input_Email': 'bookhub_reg_email'
    };

    Object.keys(fields).forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        var saved = localStorage.getItem(fields[id]);
        if (saved && !el.value) {
            el.value = saved;
        }
        el.addEventListener('input', function() {
            localStorage.setItem(fields[id], this.value);
        });
    });

    document.getElementById('registerForm').addEventListener('submit', function() {
        Object.values(fields).forEach(function(key) {
            localStorage.removeItem(key);
        });
    });
})();

(function(){
  const input = document.getElementById('avatar');
  const preview = document.getElementById('avatar-preview');

  // Validation settings:
  const maxSizeBytes = 2 * 1024 * 1024; // 2 mb
  const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];

  input.addEventListener('change', function(event) {
    const file = event.target.files[0];

    // Reset all
    preview.src = '/img/svg/profile-nophoto.svg';
    preview.alt = '';

    if (!file) {
      return;
    }

    // 1) File type
    if (!allowedTypes.includes(file.type)) {
      return;
    }

    // 2) File size
    if (file.size > maxSizeBytes) {
      return;
    }
      
    const reader = new FileReader();
    reader.onload = function(e) {
      preview.src = e.target.result;
      preview.alt = 'Uploaded Avatar';
      preview.style.marginTop = '10px';
      preview.style.width = '45px';
      preview.style.height = '45px';
      preview.style.borderRadius = '50%';
      preview.style.border = '3px solid #6474C9';
    };
    reader.readAsDataURL(file);
  });
})();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
