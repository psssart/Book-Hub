@using System.Security.Claims
@model App.BLL.DTO.Message

@{
    ViewData["Title"] = "Edit Message";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = User.Identity!.IsAuthenticated && currentUserId == Model.AppUserId.ToString();
    var discussionId = Model.Topic?.DiscussionId;
}

<head>
    <link rel="stylesheet" href="~/css/discussion-details.css" asp-append-version="true">
</head>

<div class="container-xxl py-4">
    <!-- Breadcrumb navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Discussions" asp-action="Index">Discussions</a></li>
            @if (Model.Topic?.Discussion != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Discussions" asp-action="Details" asp-route-id="@discussionId">
                        @Model.Topic.Discussion.Tittle
                    </a>
                </li>
            }
            @if (Model.Topic != null)
            {
                <li class="breadcrumb-item text-truncate" style="max-width: 200px;">
                    @Model.Topic.Tittle
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">Edit Message</li>
        </ol>
    </nav>

    <!-- Edit Form Container -->
    <div class="discussion-post-container shadow-sm" style="max-width: 700px;">
        <div class="discussion-post-content">
            <!-- Header -->
            <div class="discussion-post-header mb-4">
                <h2 class="discussion-post-title">
                    <i class="bi bi-pencil-square"></i> Edit Message
                </h2>
                @if (Model.Topic != null)
                {
                    <p class="text-muted mb-0">
                        <i class="bi bi-chat-left-text"></i> Reply in topic: <strong>@Model.Topic.Tittle</strong>
                    </p>
                }
            </div>

            <!-- Original message info -->
            <div class="message-card mb-4" style="background-color: var(--bg-input, #f8f9fa);">
                <div class="message-header">
                    <span class="message-author">
                        <i class="bi bi-person-fill"></i> @(Model.AppUser?.UserName ?? "Unknown")
                    </span>
                    <span class="message-time">
                        <i class="bi bi-clock"></i> @Model.CreationTime.ToString("MMM dd, yyyy 'at' HH:mm")
                    </span>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Hidden fields -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AppUserId" />
                <input type="hidden" asp-for="TopicId" />
                <input type="hidden" asp-for="CreationTime" />

                <!-- Content -->
                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold">
                        <i class="bi bi-chat-text"></i> Your Message <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Content" class="form-control" rows="6"
                              placeholder="Write your message..." required autofocus></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex gap-2 justify-content-between pt-3 border-top">
                    @if (discussionId != null)
                    {
                        <a asp-controller="Discussions" asp-action="Details" asp-route-id="@discussionId"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Discussion
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Topics" asp-action="Details" asp-route-id="@Model.TopicId"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Topic
                        </a>
                    }
                    <div class="d-flex gap-2">
                        @if (discussionId != null)
                        {
                            <a asp-controller="Discussions" asp-action="Details" asp-route-id="@discussionId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Cancel
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Topics" asp-action="Details" asp-route-id="@Model.TopicId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Cancel
                            </a>
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Context card showing the topic content -->
    @if (Model.Topic != null)
    {
        <div class="card mt-4" style="max-width: 700px;">
            <div class="card-header bg-transparent">
                <h6 class="mb-0 text-muted">
                    <i class="bi bi-chat-left-text"></i> Topic Context
                </h6>
            </div>
            <div class="card-body">
                <h6 class="card-title">@Model.Topic.Tittle</h6>
                <p class="card-text text-muted small mb-0" style="white-space: pre-wrap;">@(Model.Topic.Content?.Length > 300 ? Model.Topic.Content.Substring(0, 300) + "..." : Model.Topic.Content)</p>
            </div>
        </div>
    }

    <!-- Info card -->
    <div class="card mt-3" style="max-width: 700px;">
        <div class="card-body">
            <h6 class="card-title text-muted">
                <i class="bi bi-info-circle"></i> Editing Info
            </h6>
            <ul class="small text-muted mb-0">
                <li>Your original message timestamp will be preserved</li>
                <li>An edited indicator may be shown to other users</li>
                <li>Keep your messages constructive and respectful</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
