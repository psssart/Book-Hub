@model WebApp.Models.AuthorDetailsViewModel

@{
    ViewData["Title"] = Model.Author.Name;
}

<div class="container mt-4">
    <dl class="row">
        
        <div class="col-12 col-lg-7 text-center">
            <img class="author-page-image mw-100" src="data:image;base64,@Convert.ToBase64String(Model.Author.imageData)" height="438px" alt="Picture not found!"/>
        </div>
        <div class="col-12 col-lg-5 d-flex flex-column gap-3 mt-3 mt-lg-0">
            <div class="border-bottom d-flex justify-content-between">
                <span class="fs-2">@Html.DisplayFor(model => model.Author.Name)</span>
                <span class="card-title d-flex align-items-end">@Html.DisplayFor(model => model.Author.Age) yo</span>
            </div>
            <div class="fs-5">
                @Html.DisplayFor(model => model.Author.Biography)
            </div>
        </div>

    </dl>
    
    <dl class="row">
        <div class="col-12 fs-2 text-center mt-3 border-top">
            Books
        </div>
        <div class="col-12">
            @await Html.PartialAsync("~/Views/Home/_SearchResults.cshtml", Model.Search)
        </div>
        
    </dl>
</div>

<style>
    .search_results {
        position: relative;
        padding: 0 1rem 0 1rem;
    }
</style>
