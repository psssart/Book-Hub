@using Microsoft.AspNetCore.Http
@model App.Domain.Entities.Book

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Book</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PublisherId" class="control-label">Publisher</label>
                <select asp-for="PublisherId" class="form-control" asp-items="ViewBag.PublisherId">
                    <option value="">Select Publisher</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Tittle" class="control-label"></label>
                <input asp-for="Tittle" class="form-control" />
                <span asp-validation-for="Tittle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReleaseYear" class="control-label"></label>
                <input asp-for="ReleaseYear" class="form-control" />
                <span asp-validation-for="ReleaseYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group my-2 text-center">
                <label asp-for="imageData" class="control-label p-2 rounded border-2" 
                       style="background-color: var(--secondary-hover); cursor: pointer;">
                    Image
                </label>
                
                <input asp-for="imageData"
                       class="form-control"
                       type="file"
                       id="imageData"
                       accept="image/*" />

                <div id="imagePreviewWrapper" class="mt-2" style="display:none;">
                    <img id="imagePreview"
                         alt="Preview"
                         style="max-width:100%;max-height:260px;object-fit:contain;border:1px solid #ddd;border-radius:6px;padding:4px;" />
                    <div class="mt-2 d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnChange">Change</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="btnClear">Clear</button>
                        <span id="fileName" class="text-muted ms-2"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script>
    (function () {
        const input = document.getElementById('imageData');
        const wrap = document.getElementById('imagePreviewWrapper');
        const img = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const btnChange = document.getElementById('btnChange');
        const btnClear = document.getElementById('btnClear');

        function showPreview(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                img.src = e.target.result;
                wrap.style.display = 'block';
                fileName.textContent = file.name || '';
            };
            reader.readAsDataURL(file);
        }

        input.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (file) showPreview(file);
        });

        btnChange?.addEventListener('click', () => input.click());

        btnClear?.addEventListener('click', () => {
            input.value = '';
            img.removeAttribute('src');
            fileName.textContent = '';
            wrap.style.display = 'none';
        });
    })();
</script>
}
