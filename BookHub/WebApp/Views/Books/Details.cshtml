@using App.Domain.Address_Tables
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Text
@using App.Domain.Entities
@model App.Domain.Entities.Book

@{
    ViewData["Title"] = Model.Tittle;
    
    int quantity = 0; 
    float sum = 0;
    string reviews = "";
    @if (ViewData["Ratings"] != null && ((List<Rating>)ViewData["Ratings"]!).Any())
    {
        @foreach (var rating in (List<Rating>)ViewData["Ratings"]!)
        {
            quantity++;
            sum += rating.Value;
            reviews += rating.AppUser!.UserName + ":\n" + rating.Comment + "\t" + GenerateStarIcons((int)Math.Round(rating.Value)) + "\n\n";
        }
    }
    float averageRating = quantity > 0 ? sum / quantity : 0;
    string formattedRating = averageRating.ToString("0.0");
    int roundedRating = (int)Math.Round(averageRating); // Closest integer
}

<div class="container mt-4">
    <div class="row align-items-center">
        
        <div class="col-12 col-lg-4 text-center">
            <img class="book-page-image" src="data:image/jpeg;base64,@Convert.ToBase64String(Model.imageData)" width="285px" height="438px" alt="Picture not found!"/>
        </div>
        
        <div class="col-0 d-none col-lg-auto d-lg-flex">
            <div class="vr" style="height: 435px;"></div>
        </div>
        
        <div class="col-12 col-lg-4">
            @* <img class="vertical-line" src="~/img/svg/vertical-line.svg" alt=""> *@
            <div class="d-flex flex-column">
                <div class="author-name border-bottom">@Model.Tittle</div>
                <div class="pt-1 pb-3">
                    @Model.Description
                </div>
                <div class="row-element">
                    <div class="sub-header border-bottom">Score</div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="score-stars">
                            @{
                                int scoreFullStars = (int)Math.Floor(averageRating);
                                bool scoreHasHalf = (averageRating - scoreFullStars) >= 0.5f;
                                int scoreEmptyStars = 5 - scoreFullStars - (scoreHasHalf ? 1 : 0);
                            }
                            @for (var i = 0; i < scoreFullStars; i++)
                            {
                                <img class="rating-star" src="~/img/svg/rating-checked.svg" width="24px" height="24px" alt="">
                            }
                            @if (scoreHasHalf)
                            {
                                <img class="rating-star" src="~/img/svg/rating-half.svg" width="24px" height="24px" alt="">
                            }
                            @for (var i = 0; i < scoreEmptyStars; i++)
                            {
                                <img class="rating-star" src="~/img/svg/rating-unchecked.svg" width="24px" height="24px" alt="">
                            }
                        </span>
                        <span class="pt-2">@formattedRating</span>
                    </div>
                </div>
                <div class="row-element">
                    <div class="sub-header border-bottom">
                        Authors
                    </div>
                    <div class="author-frame">
                        <div class="author-frame-name">
                            @if (ViewData["BookAuthors"] != null && ((List<BookAuthor>)ViewData["BookAuthors"]!).Any())
                            {
                                var bookAuthors = ViewData["BookAuthors"] as List<BookAuthor>;
                                for (var i = 0; i < bookAuthors!.Count; i++)
                                {
                                    <a asp-controller="Authors" asp-action="Details" asp-route-id="@bookAuthors[i].Author!.Id">@bookAuthors[i].Author!.Name</a>@(i < bookAuthors.Count - 1 ? ", " : "")
                                }
                            }
                            else
                            {
                                <p>No authors found for this book.</p>
                            }
                        </div>
                    </div>

                </div>
                <div class="row-element">
                    <div class="sub-header border-bottom">Publisher</div>
                    @if (Model.Publisher != null)
                    {
                        <a asp-controller="Publishers" asp-action="Details" asp-route-id="@Model.Publisher.Id">@Model.Publisher.Name</a>
                    }
                    else
                    {
                        <span>Unknown publisher</span>
                    }
                </div>
                <div class="row-element">
                    <div class="sub-header border-bottom">Genres</div>
                    @if (ViewData["BookGenres"] != null && ((List<BookGenre>)ViewData["BookGenres"]!).Any())
                    {
                        var bookGenres = ViewData["BookGenres"] as List<BookGenre>;
                        string genres = string.Join(", ", bookGenres!.Select(bookGenre => bookGenre.Genre!.Name));
                        <span>@genres</span>
                    }
                    else
                    {
                        <p>No genres found for this book.</p>
                    }
                </div>

            </div>
        </div>

        <div class="col-0 d-none col-lg-auto d-lg-flex">
            <div class="vr" style="height: 435px;"></div>
        </div>
        
        <div class="col-12 col-lg-3">
            @* <img class="vertical-line" src="~/img/svg/vertical-line.svg" alt=""> *@
            <div class="d-flex flex-column">
                @{
                    var warehouses = ViewData["BookWarehouses"] as List<BookWarehouses> ?? new List<BookWarehouses>();
                    bool isInStock = warehouses.Any(bw => bw.Count > 0);
                }
                <div class="price fs-3">30.21 € Physical</div>
                <div class="d-flex flex-column gap-3 mx-4 pb-4 border-bottom">
                    @if (isInStock)
                    {
                        <a asp-action="Availability" asp-route-id="@Model.Id">
                            <div class="login-button">
                                <div class="text-white">
                                    Check availability
                                </div>
                            </div>
                        </a>
                    }
                    else
                    {
                        <form asp-controller="Books" asp-action="SubscribeOnBook" method="post">
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <div class="login-button" style="cursor: pointer; background-color: #D9D9D9;" onclick="this.closest('form').submit();">
                                <div class="text-black">
                                    Order
                                </div>
                            </div>
                        </form>
                    }
                </div>
                <div class="price fs-3 mt-2">@Html.DisplayFor(model => model.Price) € eBook</div>
                <div class="d-flex flex-column gap-3 mx-4">
                    <div class="login-button d-none">
                        <div class="text-white">
                            Check availability
                        </div>
                    </div>
                    <form asp-controller="Books" asp-action="AddToTempCart" method="post">
                        <input type="hidden" name="id" value="@Model.Id"/>
                        <div class="login-button" onclick="this.closest('form').submit();">
                            <div class="text-white">
                                Add to cart
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
        
        <div class="w-100"></div>
        <div class="col-12 mt-3 mt-lg-4">
            <div class="sub-header fs-4 fs-lg-3">
                Reviews - @(((List<Rating>)ViewData["Ratings"]!).Count)
            </div>

            @if (ViewData["Ratings"] != null && ((List<Rating>)ViewData["Ratings"]!).Any())
            { 
                @foreach (var rating in (List<Rating>)ViewData["Ratings"]!)
                {
                    <div class="author-frame border-top d-flex align-items-start align-items-lg-center gap-2 py-2">
                        @if (rating.AppUser!.AvatarImageData != null)
                        { 
                            <img class="author-image" 
                                 src="data:image/jpeg;base64,@Convert.ToBase64String(rating.AppUser!.AvatarImageData)" 
                                 alt=""/>
                        }
                        else
                        { 
                            <img class="author-image" src="~/img/svg/profile-nophoto.svg" alt=""/>
                        }

                        <div class="author-frame-name-review mb-0">
                            <div class="mb-1">
                                @{
                                    int fullStars = (int)Math.Floor(rating.Value);
                                    bool hasHalf = (rating.Value - fullStars) >= 0.5f;
                                    int emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
                                }
                                @for (var i = 0; i < fullStars; i++)
                                {
                                    <img src="~/img/svg/rating-checked.svg" width="14px" height="14px" alt="">
                                }
                                @if (hasHalf)
                                {
                                    <img src="~/img/svg/rating-half.svg" width="14px" height="14px" alt="">
                                }
                                @for (var i = 0; i < emptyStars; i++)
                                {
                                    <img src="~/img/svg/rating-unchecked.svg" width="14px" height="14px" alt="">
                                }
                            </div>
                            <strong>@rating.AppUser!.FirstName</strong>: @rating.Comment
                        </div>
                    </div>
                }
            }
        </div>
        
    </div>
</div>

@functions
{
    // Helper function to generate star icons based on the rating value
    string GenerateStarIcons(int rating)
    {
        StringBuilder stars = new StringBuilder();
        for (int i = 0; i < 5; i++)
        {
            if (i < rating)
            {
                stars.Append("★"); // Full star
            }
            else
            {
                stars.Append("☆"); // Empty star
            }
        }
        return stars.ToString();
    }
}
