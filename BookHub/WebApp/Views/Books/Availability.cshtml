@using App.Domain.Address_Tables
@using App.Domain.Entities
@model WebApp.ViewModels.BookAvailabilityViewModel

@{
    ViewData["Title"] = "Availability - " + Model.Book.Tittle;

    var bookAuthors = ViewData["BookAuthors"] as List<BookAuthor> ?? new List<BookAuthor>();
    var authorsText = bookAuthors.Any()
        ? string.Join(", ", bookAuthors.Select(ba => ba.Author!.Name))
        : "Unknown author";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />
<link rel="stylesheet" href="~/css/availability.css" asp-append-version="true" />

<div class="availability-page">
    <!-- Book info bar -->
    <div class="availability-book-info">
        @if (Model.Book.imageData != null)
        {
            <img src="data:image;base64,@Convert.ToBase64String(Model.Book.imageData)" alt="@Model.Book.Tittle" />
        }
        <div>
            <h4 class="availability-book-title">@Model.Book.Tittle</h4>
            <p class="availability-book-authors">@authorsText</p>
        </div>
        <div class="availability-back-link">
            <a asp-action="Details" asp-route-id="@Model.Book.Id">
                <i class="bi bi-arrow-left"></i> Back to details
            </a>
        </div>
    </div>

    <!-- Filter bar -->
    <div class="availability-filters">
        <div class="filter-group">
            <label for="countryFilter">Country</label>
            <select id="countryFilter">
                <option value="">All countries</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country">@country</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label for="warehouseSelector">Warehouse</label>
            <select id="warehouseSelector">
                <option value="">-- All warehouses --</option>
                @foreach (var w in Model.AllWarehouses)
                {
                    var bw = Model.BookWarehouses.FirstOrDefault(bw => bw.WarehouseId == w.Id);
                    var stockText = bw != null ? $" ({bw.Count} in stock)" : " (N/A)";
                    <option value="@w.Id">@w.Name@stockText</option>
                }
            </select>
        </div>
    </div>

    <!-- Map -->
    <div class="availability-map-container">
        <div id="availability-map"></div>
    </div>

    <!-- Info panel -->
    <div id="infoPanel" class="availability-info-panel empty">
        <p class="text-center mb-0" style="color: var(--text-muted);">Select a warehouse to see stock details</p>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/book-availability.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var allWarehouses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AllWarehouses.Select(w => new {
                    id = w.Id.ToString(),
                    name = w.Name,
                    country = w.Country,
                    gpsX = w.GpsX,
                    gpsY = w.GpsY
                })));

            var bookWarehouses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.BookWarehouses.Select(bw => new {
                    warehouseId = bw.WarehouseId.ToString(),
                    count = bw.Count,
                    lastSupply = bw.LastSupply
                })));

            window.BookAvailability.init(allWarehouses, bookWarehouses);
        });
    </script>
}
