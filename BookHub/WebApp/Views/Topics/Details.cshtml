@using System.Security.Claims
@using App.Domain.Entities
@model App.BLL.DTO.Topic

@{
    ViewData["Title"] = Model.Tittle;
    var messages = (ViewData["Messages"] as List<App.BLL.DTO.Message>) ?? new List<App.BLL.DTO.Message>();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = User.Identity!.IsAuthenticated && currentUserId == Model.AppUserId.ToString();
}

<head>
    <link rel="stylesheet" href="~/css/discussion-details.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/topic-details.css" asp-append-version="true">
</head>

<div class="container-xxl py-4">
    <!-- Breadcrumb navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Discussions" asp-action="Index">Discussions</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Discussions" asp-action="Details" asp-route-id="@Model.Discussion!.Id">
                    @Model.Discussion!.Tittle
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Tittle</li>
        </ol>
    </nav>

    <!-- Main Topic Post -->
    <div class="topic-post-container shadow-sm mb-4">
        <div class="topic-post-main">
            <!-- Left: Topic stats -->
            <div class="topic-post-sidebar">
                <div class="vote-section">
                    <i class="bi bi-chat-dots-fill text-primary"></i>
                    <span class="vote-count">@messages.Count</span>
                    <span class="vote-label">messages</span>
                </div>
            </div>

            <!-- Center: Topic content -->
            <div class="topic-post-content">
                <!-- Header with title and metadata -->
                <div class="topic-post-header">
                    <h2 class="topic-post-title text-truncate">@Model.Tittle</h2>
                    <div class="topic-post-meta">
                        <span class="meta-item" style="max-width: 200px;">
                            @if (Model.AppUser!.AvatarImageData != null)
                            {
                                <img src="data:image;base64,@Convert.ToBase64String(Model.AppUser!.AvatarImageData)"
                                     alt="User Avatar" style="height: 21px;width: 25px;">
                            }
                            else
                            {
                                <i class="bi bi-person-circle"></i>
                            }
                            Posted by <strong>@Model.AppUser!.FirstName @Model.AppUser!.LastName</strong>
                        </span>
                        <span class="meta-item">
                            <i class="bi bi-clock"></i>
                            @Model.CreationTime.ToString("MMM dd, yyyy 'at' HH:mm")
                        </span>
                        @if (isOwner)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="meta-item edit-link">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                        }
                    </div>
                </div>

                <!-- Topic body -->
                <div class="topic-post-body text-truncate">
                    <p class="topic-post-description">@Model.Content</p>
                </div>

                <!-- Discussion link badge -->
                <div class="topic-post-tags mt-3">
                    <a asp-controller="Discussions" asp-action="Details" asp-route-id="@Model.Discussion!.Id"
                       class="badge bg-primary text-truncate">
                        <i class="bi bi-chat-square-text"></i> @Model.Discussion!.Tittle
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages Section -->
    <div class="messages-section">
        <h4 class="messages-header mb-3">
            <i class="bi bi-chat-left-text"></i> Messages (<span id="messages-count">@messages.Count</span>)
        </h4>

        <div id="messages-container" class="messages-list">
            @if (messages.Any())
            {
                @foreach (var message in messages.OrderBy(m => m.CreationTime))
                {
                    var isMessageOwner = User.Identity!.IsAuthenticated && currentUserId == message.AppUserId.ToString();

                    <div class="message-card" data-message-id="@message.Id">
                        <div class="message-header">
                            <span class="message-author text-truncate">
                                @if (message.AppUser!.AvatarImageData != null)
                                {
                                    <img src="data:image;base64,@Convert.ToBase64String(message.AppUser!.AvatarImageData)"
                                         alt="User Avatar" style="height: 21px;width: 25px;border-radius: 25%;">
                                }
                                else
                                {
                                    <i class="bi bi-person-circle"></i>
                                }
                                @message.AppUser!.FirstName @message.AppUser!.LastName
                            </span>
                            <span class="message-time">
                                @message.CreationTime.ToString("MMM dd, HH:mm")
                            @if (isMessageOwner)
                            {
                                <a asp-controller="Messages" asp-action="Edit" asp-route-id="@message.Id"
                                   class="message-edit-link">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            </span>
                        </div>
                        <div class="message-content">
                            @message.Content
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-messages-placeholder text-center py-4">
                    <i class="bi bi-chat" style="font-size: 2.5rem; color: #6c757d;"></i>
                    <p class="text-muted mt-2 mb-0">No messages yet. Be the first to reply!</p>
                </div>
            }
        </div>
    </div>

    <!-- Scroll to bottom button -->
    <button id="scrollToBottomBtn" class="scroll-to-bottom-btn" title="Scroll to latest message" style="display: none;">
        <i class="bi bi-arrow-down"></i>
        <span id="newMessagesBadge" class="new-messages-badge" style="display: none;"></span>
    </button>

    <!-- Create Message Form -->
    <div class="create-message-section mt-4">
        <div class="create-message-form shadow-sm">
            <h5 class="mb-3">
                <i class="bi bi-reply"></i> Reply to this topic
            </h5>
            <form asp-controller="Messages" asp-action="Create" method="post" id="messageForm">
                <input type="hidden" name="AppUserId" value="@currentUserId"/>
                <input type="hidden" name="TopicId" value="@Model.Id"/>

                <div class="input-group">
                    <input type="text" class="form-control" name="Content" id="messageInput"
                           placeholder="Write your message..." required autocomplete="off"/>
                    <button type="submit" class="btn btn-primary" id="sendButton">
                        <i class="bi bi-send"></i> Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (async function() {
            const topicId = '@Model.Id';
            const currentUserId = '@currentUserId';
            let unreadCount = 0;

            const messagesContainer = document.getElementById('messages-container');
            const scrollToBottomBtn = document.getElementById('scrollToBottomBtn');
            const newMessagesBadge = document.getElementById('newMessagesBadge');
            const messageForm = document.getElementById('messageForm');
            const messageInput = document.getElementById('messageInput');
            const sendButton = document.getElementById('sendButton');

            // Scroll to bottom on initial page load
            scrollToBottom(false);

            // --- Scroll position tracking ---
            function isNearBottom(threshold) {
                threshold = threshold || 150;
                return (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - threshold);
            }

            function scrollToBottom(smooth) {
                window.scrollTo({ top: document.body.scrollHeight, behavior: smooth ? 'smooth' : 'instant' });
            }

            function showScrollButton() {
                scrollToBottomBtn.style.display = 'flex';
            }

            function hideScrollButton() {
                scrollToBottomBtn.style.display = 'none';
                unreadCount = 0;
                newMessagesBadge.style.display = 'none';
            }

            function updateBadge() {
                if (unreadCount > 0) {
                    newMessagesBadge.textContent = unreadCount;
                    newMessagesBadge.style.display = 'flex';
                } else {
                    newMessagesBadge.style.display = 'none';
                }
            }

            window.addEventListener('scroll', function() {
                if (isNearBottom()) {
                    hideScrollButton();
                }
            });

            scrollToBottomBtn.addEventListener('click', function() {
                scrollToBottom(true);
                hideScrollButton();
            });

            // --- AJAX form submission ---
            messageForm.addEventListener('submit', async function(e) {
                e.preventDefault();

                const content = messageInput.value.trim();
                if (!content) return;

                sendButton.disabled = true;

                try {
                    const formData = new FormData(messageForm);
                    const response = await fetch(messageForm.action, {
                        method: 'POST',
                        body: formData,
                        redirect: 'manual'
                    });

                    // Success (redirect means the server processed it)
                    messageInput.value = '';
                } catch (error) {
                    console.error('Failed to send message:', error);
                } finally {
                    sendButton.disabled = false;
                    messageInput.focus();
                }
            });

            // --- SignalR ---
            try {
                await window.discussionHub.initialize();
                await window.discussionHub.joinTopic(topicId);

                window.discussionHub.onReceiveMessage(function(notification) {
                    if (notification.topicId === topicId) {
                        addMessageToUI(notification);
                    }
                });

                console.log('SignalR connected for topic:', topicId);
            } catch (error) {
                console.error('Failed to connect to SignalR:', error);
            }

            function addMessageToUI(notification) {
                // Remove "No messages yet" placeholder if present
                const noMessagesPlaceholder = messagesContainer.querySelector('.no-messages-placeholder');
                if (noMessagesPlaceholder) {
                    noMessagesPlaceholder.remove();
                }

                // Prevent duplicate messages
                if (messagesContainer.querySelector(`[data-message-id="${notification.messageId}"]`)) {
                    return;
                }

                const isOwnMessage = notification.appUserId === currentUserId;
                const wasNearBottom = isNearBottom();

                // Format creation time
                const creationTime = new Date(notification.creationTime).toLocaleString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                // Create new message element
                const messageDiv = document.createElement('div');
                messageDiv.className = 'message-card new-message';
                messageDiv.setAttribute('data-message-id', notification.messageId);

                const notificationAvatar = notification.userAvatarBase64 ?
                    `<img src="data:image;base64,${notification.userAvatarBase64}" alt="User Avatar" style="width:25px;height:25px;">`
                    : '<i class="bi bi-person-circle"></i>';
                
                messageDiv.innerHTML = `
                    <div class="message-header">
                        <span class="message-author text-truncate">
                            ${notificationAvatar} ${escapeHtml(notification.userName)}
                        </span>
                        <span class="message-time">${creationTime}</span>
                    </div>
                    <div class="message-content">${escapeHtml(notification.content)}</div>
                `;

                messagesContainer.appendChild(messageDiv);

                // Update messages count
                const countSpan = document.getElementById('messages-count');
                const newCount = messagesContainer.querySelectorAll('.message-card').length;
                countSpan.textContent = newCount;

                // Scroll behavior
                if (isOwnMessage || wasNearBottom) {
                    // Auto-scroll for own messages or if already at bottom
                    scrollToBottom(true);
                    hideScrollButton();
                } else {
                    // Show scroll-to-bottom button with unread count
                    unreadCount++;
                    updateBadge();
                    showScrollButton();
                }

                // Remove highlight class after animation
                setTimeout(() => {
                    messageDiv.classList.remove('new-message');
                }, 3000);
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // Cleanup on page unload
            window.addEventListener('beforeunload', async function() {
                await window.discussionHub.leaveTopic(topicId);
            });
        })();
    </script>
}
