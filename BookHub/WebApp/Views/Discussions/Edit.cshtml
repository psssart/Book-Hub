@using Microsoft.IdentityModel.Tokens
@using System.Security.Claims
@model App.Domain.Entities.Discussion

@{
    ViewData["Title"] = "Edit Discussion";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = User.Identity!.IsAuthenticated && currentUserId == Model.AppUserId.ToString();
}

<head>
    <link rel="stylesheet" href="~/css/discussion-details.css" asp-append-version="true">
</head>

<div class="container-xxl py-4">
    <!-- Breadcrumb navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Discussions</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Tittle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <!-- Edit Form Container -->
    <div class="discussion-post-container shadow-sm">
        <div class="discussion-post-content">
            <div class="discussion-post-header mb-4">
                <h2 class="discussion-post-title">
                    <i class="bi bi-pencil-square"></i> Edit Discussion
                </h2>
                <p class="text-muted mb-0">Update your discussion details below</p>
            </div>

            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Hidden fields -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="AppUserId" />
                <input type="hidden" asp-for="CreationTime" />

                <div class="row">
                    <!-- Left column: Image -->
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header bg-transparent">
                                <h6 class="mb-0"><i class="bi bi-image"></i> Discussion Image</h6>
                            </div>
                            <div class="card-body text-center">
                                <div id="imagePreviewContainer" class="mb-3">
                                    @if (!Model.imageData.IsNullOrEmpty())
                                    {
                                        <img id="imagePreview" src="data:image/jpeg;base64,@Convert.ToBase64String(Model.imageData)"
                                             alt="Discussion image"
                                             style="max-width: 100%; max-height: 200px; border-radius: 8px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div id="imagePlaceholder" class="d-flex align-items-center justify-content-center"
                                             style="height: 150px; background-color: var(--bg-input, #f8f9fa); border-radius: 8px; border: 2px dashed #dee2e6;">
                                            <div class="text-center text-muted">
                                                <i class="bi bi-image" style="font-size: 2rem;"></i>
                                                <p class="mb-0 small">No image</p>
                                            </div>
                                        </div>
                                        <img id="imagePreview" src="" alt="Discussion image"
                                             style="max-width: 100%; max-height: 200px; border-radius: 8px; object-fit: cover; display: none;" />
                                    }
                                </div>

                                <label for="imageInput" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-upload"></i> Choose Image
                                </label>
                                <input type="file" id="imageInput" name="imageFile" accept="image/*"
                                       class="d-none" onchange="previewImage(this)" />

                                @if (!Model.imageData.IsNullOrEmpty())
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-2" onclick="clearImage()">
                                        <i class="bi bi-x-circle"></i> Remove Image
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right column: Form fields -->
                    <div class="col-md-8">
                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Tittle" class="form-label fw-semibold">
                                <i class="bi bi-type-h1"></i> Title <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Tittle" class="form-control form-control-lg"
                                   placeholder="Enter discussion title" required />
                            <span asp-validation-for="Tittle" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-text-paragraph"></i> Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="5"
                                      placeholder="Describe what this discussion is about..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Related Content Section -->
                        <div class="card mb-3">
                            <div class="card-header bg-transparent">
                                <h6 class="mb-0"><i class="bi bi-tags"></i> Related Content (Optional)</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 mb-3 mb-md-0">
                                        <label asp-for="BookId" class="form-label small fw-semibold">
                                            <i class="bi bi-book"></i> Book
                                        </label>
                                        <select asp-for="BookId" style="height: 2rem;" class="form-select form-select-sm" asp-items="ViewBag.BookId">
                                            <option value="">-- No book --</option>
                                        </select>
                                        <span asp-validation-for="BookId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4 mb-3 mb-md-0">
                                        <label asp-for="GenreId" class="form-label small fw-semibold">
                                            <i class="bi bi-tag"></i> Genre
                                        </label>
                                        <select asp-for="GenreId" style="height: 2rem;" class="form-select form-select-sm" asp-items="ViewBag.GenreId">
                                            <option value="">-- No genre --</option>
                                        </select>
                                        <span asp-validation-for="GenreId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="AuthorId" class="form-label small fw-semibold">
                                            <i class="bi bi-pen"></i> Author
                                        </label>
                                        <select asp-for="AuthorId" style="height: 2rem;" class="form-select form-select-sm" asp-items="ViewBag.AuthorId">
                                            <option value="">-- No author --</option>
                                        </select>
                                        <span asp-validation-for="AuthorId" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('imagePlaceholder');

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    if (placeholder) {
                        placeholder.style.display = 'none';
                    }
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearImage() {
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('imagePlaceholder');
            const input = document.getElementById('imageInput');

            preview.src = '';
            preview.style.display = 'none';
            if (placeholder) {
                placeholder.style.display = 'flex';
            }
            input.value = '';
        }
    </script>
}
