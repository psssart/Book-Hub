@model WebApp.Models.UserEditViewModel

@{
    ViewData["Title"] = "Edit User";
}

<h1>Edit User</h1>

<h4>@Model.FirstName @Model.LastName</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group my-2">
                <label class="control-label">Roles</label>
                @foreach (var role in Model.AllRoles)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="selectedRoles" value="@role"
                               id="role_@role" @(Model.Roles.Contains(role) ? "checked" : "") />
                        <label class="form-check-label" for="role_@role">@role</label>
                    </div>
                }
            </div>
            <div class="form-group my-2 text-center">
                <label class="control-label p-2 rounded border-2"
                       style="background-color: var(--secondary-hover); cursor: pointer;">
                    Avatar
                </label>

                <input class="form-control"
                       type="file"
                       id="avatarFile"
                       name="avatarFile"
                       accept="image/*" />

                @{
                    var hasBytes = Model.AvatarImageData != null && Model.AvatarImageData.Length > 0;
                    var base64 = hasBytes ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.AvatarImageData!)}" : "";
                }
                <div id="imagePreviewWrapper" class="mt-2" style="display:@(hasBytes ? "block" : "none");">
                    <img id="imagePreview" src="@(hasBytes ? base64 : "")"
                         alt="Preview"
                         style="max-width:100%;max-height:260px;object-fit:contain;border:1px solid #ddd;border-radius:6px;padding:4px;" />
                    <div class="mt-2 d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnChange">Change</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="btnClear">Clear</button>
                        <span id="fileName" class="text-muted ms-2"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

<script>
    (function () {
        const input = document.getElementById('avatarFile');
        const wrap = document.getElementById('imagePreviewWrapper');
        const img = document.getElementById('imagePreview');
        const fileName = document.getElementById('fileName');
        const btnChange = document.getElementById('btnChange');
        const btnClear = document.getElementById('btnClear');

        function showPreview(file) {
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                img.src = e.target.result;
                wrap.style.display = 'block';
                fileName.textContent = file.name || '';
            };
            reader.readAsDataURL(file);
        }

        input.addEventListener('change', function () {
            const file = this.files && this.files[0];
            if (file) showPreview(file);
        });

        btnChange?.addEventListener('click', () => input.click());

        btnClear?.addEventListener('click', () => {
            input.value = '';
            img.removeAttribute('src');
            fileName.textContent = '';
            wrap.style.display = 'none';
        });
    })();
</script>
}
