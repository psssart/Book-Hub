@{
    var currentTheme = Context.Request.Cookies["theme"] ?? "light";
    var isDark = currentTheme == "dark";
    
    var spriteInjected = ViewData["ThemeSpriteInjected"] as bool? ?? false;
    if (!spriteInjected)
    {
        ViewData["ThemeSpriteInjected"] = true;
    }
}

@if (!spriteInjected)
{
<svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
    <symbol id="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1"  x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </symbol>
    <symbol id="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </symbol>
</svg>
}

<a href="#" class="theme-toggle-ctl d-flex justify-content-between align-items-center">
    <div class="p-1 pb-2">
        <svg class="theme-icon" width="20" height="20" aria-hidden="true" fill="none">
            <use href="#@(isDark ? "sun" : "moon")"></use>
        </svg>
    </div>
    <div class="w-100 d-flex justify-content-center align-items-center">
        <span class="theme-label">
            Theme
        </span>
    </div>
</a>
