@using Microsoft.AspNetCore.Identity
@{
var currentTheme = Context.Request.Cookies["theme"] ?? "light";
}
<!DOCTYPE html>
<html lang="en" data-theme="@currentTheme">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="color-scheme" content="light dark">
    <title>@ViewData["Title"] - BookHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="icon" href="~/img/svg/logo.svg" type="image/svg+xml">
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/> *@
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true"/>
    
</head>
<body>
@if(User.Identity!.IsAuthenticated) {
    <header>
        <div class="container-nav">
            <div class="navbar">
                <nav>
                    <ul>
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><img src="~/img/svg/BookHub-logo-v2.svg" alt=""></a></li>
                        <li>
                            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
                            {
                                <div class="search-form-auth">
                                    <input type="text" class="search-form-txt-auth" name="searchInput" spellcheck="false" placeholder="Search for book or author">

                                    <button class="search-form-btn-auth">
                                        <img src="~/img/svg/search-button.svg" alt="image" class="search-form-image">
                                    </button>
                                </div>
                            }
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="right-items-1-admin">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Publishers" asp-action="Index">Publishers</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Books" asp-action="Index">Books</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Authors" asp-action="Index">Authors</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Genres" asp-action="Index">Genres</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Warehouses" asp-action="Index">Warehouses</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Discussions" asp-action="Index">Discussions</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="right-items-2-admin">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Books
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="BooksGenres" asp-action="Index">BookGenre</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="BooksAuthors" asp-action="Index">BookAuthor</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="BooksWarehouses" asp-action="Index">BookWarehouse</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="right-items-1">
                            <a asp-area="" asp-controller="PurchasedBooks" asp-action="Index">
                                <img src="~/img/svg/books.svg" alt="">
                            </a>
                        </li>
                        
                        <li class="right-items-2">
                            <a asp-area="" asp-controller="PurchasedBooks" asp-action="Create">
                                <img src="~/img/svg/cart.svg" alt="">
                            </a>
                        </li>
                        <li class="right-items-3">
                            <a asp-area="" asp-controller="Discussions" asp-action="Index">
                                <img src="~/img/svg/Forums.svg" alt="">
                            </a>
                        </li>
                        <li class="right-items-4">
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                                <img src="~/img/svg/Profile.svg" alt="">
                            </a>
                        </li>
                        <li class="right-items-5">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new {area = ""})">
                                <a href="javascript:void(0);" onclick="this.closest('form').submit();">
                                    <img src="~/img/svg/logout.svg" alt="Logout">
                                </a>
                            </form>
                        </li>
                        
                    </ul>
                </nav>
            </div>
        </div>
    </header>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* <header> *@
    @*     <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" style="height: 100px"> *@
    @*         <div class="container-fluid"> *@
    @*             $1$ Temporary button #1# *@
    @*             <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BookHub</a> *@
    @*             <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" *@
    @*                     aria-expanded="false" aria-label="Toggle navigation"> *@
    @*                 <span class="navbar-toggler-icon"></span> *@
    @*             </button> *@
    @*             <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between"> *@
    @*                 <ul class="navbar-nav flex-grow-1"> *@
    @* *@
    @*                         <li> *@
    @*                             <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="PurchasedBooks" asp-action="Index">My Books</a> *@
    @*                         </li> *@
    @*                         <li> *@
    @*                             <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="PurchasedBooks" asp-action="Create">Cart</a> *@
    @*                         </li> *@
    @*                         <li> *@
    @*                             <a class="dropdown-item nav-link text-dark" asp-area="" asp-controller="Discussions" asp-action="Index">Forums</a> *@
    @*                         </li> *@
    
    @* *@
    @*                 </ul> *@
    @* *@
    @*                 <partial name="_LoginPartial"/> *@
    @*             </div> *@
    @*         </div> *@
    @*     </nav> *@
    @* </header> *@
}
else
{
    <header>
        <div class="header container-fluid p-0 m-0">
            <div class="box row-fluid d-flex">
                
                @* Logo section (only for desktop) *@
                <div class="d-none d-md-flex col-0 col-md-2 p-0">
                    <nav class="d-flex">
                        <a class="nav-link dropdown-toggle custom-dropdown d-flex align-items-center fs-2 p-2 ps-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/img/svg/logo.svg" alt="Logo" class="img-fluid" style="height: 85%;">
                        </a>
                        <ul class="dropdown-menu px-3 ms-2" style="border: none">
                            <li>
                                <partial name="_ThemeToggle"/>
                            </li>
                        </ul>
                    </nav>
                </div>
                
                @* Search section *@
                <div class="col-10 col-md-6 ps-3 ps-md-0 d-flex align-items-center justify-content-center">
                    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "d-flex w-100", @style = "height: 78%;"}))
                    {
                        <div class="search-form-auth w-100 d-flex align-items-center">
                            @{
                                var searchInput = ViewContext.HttpContext.Request.Query["searchInput"].ToString();
                                var showResults = !string.IsNullOrWhiteSpace(searchInput);
                            }
                            <input type="text" class="search-form-txt-auth fs-4 text-center h-100" name="searchInput" 
                                   spellcheck="false" placeholder="Search for book or author"
                                   value="@(showResults ? searchInput : null)" />

                            <button class="search-form-btn-auth d-flex align-items-center justify-content-center p-0">
                                @* Mobile search button *@
                                <svg width="45" height="30" viewBox="0 0 65 60" xmlns="http://www.w3.org/2000/svg"
                                     class="d-flex d-md-none search-form-image" style="color: rgb(206, 192, 115);">
                                    <path fill="currentColor" stroke="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M59.3228 58.6442C60.3086 58.9749 62.502 59.3718 63.3892 58.3135C64.2764 57.2551 64.0053 55.8881 63.7589 55.3369L43.4266 36.155C47.9859 30.7532 53.8515 17.2376 40.8388 6.38984C22.3549 -5.51621 4.98013 4.07478 1.28333 17.9652C-0.195409 32.1863 4.24062 35.1628 11.6342 40.4544C19.0278 45.746 31.5969 44.4231 38.9904 39.7929C41.6521 42.1741 53.6543 53.3526 59.3228 58.6442ZM7.56774 17.9652C4.98009 24.2489 8.43033 30.5327 10.8949 32.8477C14.7149 36.8164 25.0166 42.9017 35.6633 35.4935C46.3101 28.0853 42.8104 17.6344 39.7298 13.335C38.0046 10.9097 32.632 6.12526 24.9426 6.38984C15.331 6.72056 10.9416 9.77213 7.56774 17.9652Z"/>
                                </svg>
                                @* Desktop search button *@
                                <img src="~/img/svg/search-button.svg" alt="image" class="d-none d-md-flex search-form-image">
                            </button>
                        </div>
                    }
                </div>

                @* Sign up Log in section *@
                <div class="col-2 col-md-4 d-flex justify-content-end">
                    @* For mobile (dropdown) *@
                    <nav class="d-flex d-md-none">
                        <a class="nav-link dropdown-toggle custom-dropdown d-flex align-items-center fs-2 p-2 pe-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/img/svg/logo.svg" alt="Logo" class="img-fluid h-75">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end px-3" style="border: none">
                            <li>
                                <a asp-area="Identity" asp-page="/Account/Register" class="d-flex justify-content-center">
                                    <div class="text-wrapper-yellow w-100">
                                        <div class="text text-center">
                                            Sign up
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a asp-area="Identity" asp-page="/Account/Login" class="d-flex justify-content-center">
                                    <div class="text-wrapper-blue w-100">
                                        <div class="text text-center">
                                            Login in
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <partial name="_ThemeToggle"/>
                            </li>
                        </ul>
                    </nav>
                    @* For desktop *@
                    <div class="d-none d-md-flex gap-2 m-3">
                        <div>
                            <a asp-area="Identity" asp-page="/Account/Register">
                                <div class="text-wrapper-yellow">
                                    <div class="text text-center">
                                        Sign up
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div>
                            <a asp-area="Identity" asp-page="/Account/Login">
                                <div class="text-wrapper-blue">
                                    <div class="text text-center">
                                        Login in
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </header>
}

@RenderBody()

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/theme.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>