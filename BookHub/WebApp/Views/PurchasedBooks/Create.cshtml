@using System.Text
@model WebApp.Models.CartModel

@{
    ViewData["Title"] = "Shopping Cart";
    double totalValue = Model.Books.Sum(b => b.Price);
}

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div class="container mt-5">
    <div class="row">
    @if (Model.Books.Any())
    {
        <div class="books_results col-10">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var book in Model.Books)
                {
                    var authorsForBook = Model.BookAuthors
                        .Where(ba => ba.BookId.Equals(book.Id))
                        .Select(ba => ba.Author!)
                        .Distinct()
                        .ToList();

                    var genresForBook = Model.BookGenres
                        .Where(bg => bg.BookId.Equals(book.Id))
                        .Select(bg => bg.Genre!)
                        .Distinct()
                        .ToList();

                    var ratingsForBook = Model.Ratings.Where(r => r.BookId == book.Id).ToList();
                    int quantity = ratingsForBook.Count();
                    float sum = ratingsForBook.Sum(r => r.Value);
                    float averageRating = quantity > 0 ? sum / quantity : 0;
                    string formattedRating = averageRating.ToString("0.0");
                    int roundedRating = (int)Math.Round(averageRating);

                    <div class="col">
                        <div class="card shadow-sm" style="height: 15rem; max-width: 11rem;">
                            <a asp-area="" asp-controller="Books" asp-action="Details"
                               asp-route-id="@book.Id" class="text-decoration-none img-wrapper" style="height: 280px;">
                                <img class="card-img-top img-hover"
                                     src="data:image;base64,@Convert.ToBase64String(@book.imageData!)" alt="@book.Tittle">
                            </a>

                            <div class="card-body d-flex flex-column p-2 pb-1">
                                <h5 class="card-title text-center mb-2 fs-6">
                                    <a asp-area="" asp-controller="Books" asp-action="Details"
                                       asp-route-id="@book.Id" class="text-decoration-none">
                                        @book.Tittle
                                    </a>
                                </h5>

                                <div class="mt-auto">
                                    <div class="row small align-items-center text-center">
                                        <div class="col-7 text-nowrap pe-5">
                                            $@book.Price
                                        </div>
                                        <div class="col-5">
                                            <form asp-controller="PurchasedBooks" asp-action="RemoveFromTempCart" method="post">
                                                <input type="hidden" name="id" value="@book.Id"/>
                                                <button type="submit" class="delete-btn">X</button>
                                            </form>
                                        </div>
                                    </div>
                                    
                                    <button type="button" class="toggle-btn btn btn-link p-0 col-12 mt-2 shadow-none" style="height: 1.2rem;">
                                        <i class="bi bi-chevron-down" style="color: var(--accent-color)"></i>
                                    </button>
                                    
                                    <div class="details-section collapse">
                                        <div class="row small text-muted mb-1 align-items-center">
                                            <div class="col-9 pe-0 text-truncate">
                                                @if (authorsForBook.Any())
                                                {
                                                    var last = authorsForBook.Last();
                                                    var authorsText = string.Join(", ", authorsForBook.Select(g => g.Name));
                                                    <span title="@authorsText">
                                                      @foreach (var a in authorsForBook)
                                                      {
                                                          <a asp-area="" asp-controller="Authors" asp-action="Details"
                                                           asp-route-id="@a.Id" class="text-decoration-none">
                                                            @a.Name</a>@(a != last ? ", " : "")
                                                      }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>Unknown author</span>
                                                }
                                            </div>
                                            <div class="col-3 text-end text-nowrap ps-0">
                                                <span>@book.ReleaseYear</span>
                                            </div>
                                        </div>

                                        <div class="row small align-items-center mb-1">
                                            <div class="col-5 text-nowrap pe-0 ps-3">
                                                <div class="d-flex flex-column">
                                                    <span class="fs-5">@GenerateStarIcons(Convert.ToInt32(roundedRating))</span>
                                                    <span class="ms-4 ps-2">@formattedRating</span>
                                                </div>
                                            </div>
                                            <div class="col-7 text-end">
                                                @if (genresForBook.Any())
                                                {
                                                    var last = genresForBook.Last();
                                                    var genresText = string.Join(", ", genresForBook.Select(g => g.Name));
                                                    <span class="d-inline-block text-muted pt-1" title="@genresText"
                                                          style="display: -webkit-box !important; -webkit-line-clamp: 2; 
                                                              -webkit-box-orient: vertical; overflow: hidden; 
                                                              white-space: normal;">
                                                        @foreach (var g in genresForBook)
                                                        {
                                                            <a href="#"
                                                               class="genre-chip"
                                                               data-id="@g.Id">
                                                                @g.Name@(g.Id != last.Id ? ", " : "")
                                                            </a>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No genres</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-auto d-flex flex-column gap-2 text-center mt-5">
            <div>
                <div>Total:</div>
                <div>$@totalValue</div>
            </div>
            <form asp-controller="PurchasedBooks" asp-action="CreatePur" method="post">
                <button type="submit">Buy</button>
            </form>
        </div>
        
    }
    else
    {
        <div class="books_results col-12">
            <p>No books in the cart.</p>
        </div>
    }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".toggle-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const details = this.nextElementSibling;
                    const icon = this.querySelector("i");
                    details.classList.toggle("collapse");
                    if (details.classList.contains("collapse")) {
                        icon.classList.remove("bi-chevron-up");
                        icon.classList.add("bi-chevron-down");
                    } else {
                        icon.classList.remove("bi-chevron-down");
                        icon.classList.add("bi-chevron-up");
                    }
                });
            });
        });
    </script>
}

@functions
{
    // Helper function to generate star icons based on the rating value
    string GenerateStarIcons(int rating)
    {
        StringBuilder stars = new StringBuilder();
        for (int i = 0; i < 5; i++)
        {
            if (i < rating)
            {
                stars.Append("★"); // Full star
            }
            else
            {
                stars.Append("☆"); // Empty star
            }
        }
        return stars.ToString();
    }
}
