@using App.Domain.Entities
@using System.Security.Claims
@using System.Text
@model WebApp.Models.MyBooksModel

@{
    ViewData["Title"] = "My bookshelf";
}

<div class="d-flex w-100 justify-content-center align-items-center flex-wrap mb-4">
    <div class="lectern-wrapper position-relative d-flex align-self-end">
        <div class="ratings-book-wrapper" style="position: absolute; top: -280px; left: -10px; width: 340px;">
            <img src="~/img/png/pargament.png" alt="ratings-book" class="ratings-book-image" style="width: 340px; height: 260px;"/>
        </div>
        <img src="~/img/png/lectern.png" alt="lectern" class="lectern-image" style="width: 300px; height: auto;"/>

        <div class="open-book-wrapper" style="position: absolute; top: 11px; left: 59px; width: 180px;">
            <img src="~/img/png/open_book.png" class="open-book" alt="open-book"/>
        </div>
    </div>
    <div class="bookshelf-wrapper position-relative">
        <img src="~/img/png/bookshelf.png" alt="bookshelf" class="bookshelf-image" style="width: 800px; height: auto;"/>

        <div class="d-flex justify-content-start books-row-1"
             style="position: absolute; top: 156px; left: 167px; width: 490px;">
            <div class="d-flex book-wrapper" style="width: 95px;height: 115px;">
                <div class="d-flex flex-row justify-content-center w-100 px-1" style="z-index: 99;">
                    <span class="text-truncate pt-3 user-select-none" 
                          style="writing-mode: vertical-rl; transform: rotate(183deg); z-index: 9999; color: var(--bg-primary);">
                        Faust The Decide
                    </span>
                    <img src="~/img/books/faust.jpg" class="align-self-center pt-2" alt="bookgf" 
                         style="width: 72%;height: 96%; transform: rotate(3deg);"/>
                </div>
                <img src="~/img/png/book_1.png" class="position-absolute book" alt="book1"/>
            </div>
            <img src="~/img/png/book_2.png" class="book" alt="book2"/>
            <img src="~/img/png/book_3.png" class="book" alt="book3"/>
            <img src="~/img/png/book_4.png" class="book" alt="book4"/>
            <img src="~/img/png/book_5.png" class="book" alt="book5"/>
        </div>

        <div class="d-flex justify-content-start books-row-1"
             style="position: absolute; top: 283px; left: 167px; width: 490px;">
            <img src="~/img/png/book_1.png" class="book" alt="book1"/>
            <img src="~/img/png/book_2.png" class="book" alt="book2"/>
            <img src="~/img/png/book_3.png" class="book" alt="book3"/>
            <img src="~/img/png/book_4.png" class="book" alt="book4"/>
            <img src="~/img/png/book_5.png" class="book" alt="book5"/>
        </div>

        <div class="d-flex justify-content-start books-row-1"
             style="position: absolute; top: 421px; left: 167px; width: 490px;">
            <img src="~/img/png/book_1.png" class="book" alt="book1"/>
            <img src="~/img/png/book_2.png" class="book" alt="book2"/>
            <img src="~/img/png/book_3.png" class="book" alt="book3"/>
            <img src="~/img/png/book_4.png" class="book" alt="book4"/>
            <img src="~/img/png/book_5.png" class="book" alt="book5"/>
        </div>

        <div class="d-flex justify-content-start books-row-1"
             style="position: absolute; top: 550px; left: 167px; width: 490px;">
            <img src="~/img/png/book_1.png" class="book" alt="book1"/>
            <img src="~/img/png/book_2.png" class="book" alt="book2"/>
            <img src="~/img/png/book_3.png" class="book" alt="book3"/>
            <img src="~/img/png/book_4.png" class="book" alt="book4"/>
            <img src="~/img/png/book_5.png" class="book" alt="book5"/>
        </div>
    </div>
</div>
