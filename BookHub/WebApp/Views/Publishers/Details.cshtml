@model WebApp.Models.PublisherDetailsViewModel

@{
    ViewData["Title"] = Model.Publisher.Name;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-lg-8 mx-auto">
            <div class="border-bottom pb-3 mb-4">
                <h2 class="mb-1">@Model.Publisher.Name</h2>
                <span class="text-muted">@Model.BookCount @(Model.BookCount == 1 ? "book" : "books") published</span>
            </div>
            <div class="fs-5">
                @Model.Publisher.Description
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12 fs-2 text-center border-top pt-3">
            Books
        </div>
        <div class="col-12">
            @await Html.PartialAsync("~/Views/Home/_SearchResults.cshtml", Model.Search)
        </div>
    </div>
</div>

<style>
    .search_results {
        position: relative;
        padding: 0 1rem 0 1rem;
    }
</style>
