{
  "ConnectionStrings": {
    "DefaultConnection": "Host=sql;Port=5432;Database=bookhub;Username=postgres;Password=${POSTGRES_PASSWORD}"
  },

  "Cors": {
    "AllowedOrigins": [
      "https://myapp.com",
      "https://admin.myapp.com"
    ]
  },

  "JWT": {
    "issuer": "bookhub",
    "audience": "bookhub-users",
    "key": "${JWT_KEY}",
    "expiresInSeconds": 120
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "From": "bookhub.bot@gmail.com",
    "User": "bookhub.bot@gmail.com",
    "Password": "${SMTP_PASSWORD}",
    "Security": "StartTls",
    "AllowInvalidCertInDevelopment": false
  },

  "AllowedHosts": "*"
}
